# ==========================================
# Variáveis de Ambiente - Refúgio Familiar
# ==========================================

# Google OAuth 2.0 Client ID (Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=

# Apple Sign-In Services ID (Apple Developer Portal -> Certificates, Identifiers & Profiles)
VITE_APPLE_CLIENT_ID=

# URL da API / Backend (caso integrado a Supabase / Firebase / Node API)
VITE_API_BASE_URL=http://localhost:4000
